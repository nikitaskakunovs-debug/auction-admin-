    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "@sentry/node": "^10.70.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
